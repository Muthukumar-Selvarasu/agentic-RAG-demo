# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# OpenAI — routing and RAG generation
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# SerpApi — live Google search for INTERNET_QUERY
# https://serpapi.com
# The notebook looks up SERP_API_KEY first, then SERPAPI_KEY.
SERPAPI_KEY=your-serpapi-key
# SERP_API_KEY=your-serpapi-key

# TypeSafe (Jev) — official SDKs read TYPESAFE_API_KEY
# https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=your-typesafe-api-key
